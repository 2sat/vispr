# Copy to apps/web/.env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
ARTIFICIAL_ANALYSIS_API_KEY=
CRON_SECRET=
SELF_HOSTED_BASE_URL=
SELF_HOSTED_API_KEY=

# Server execution and explicit direct endpoint allowlist (comma-separated origins).
SUPABASE_URL=
VISPR_DIRECT_ALLOWED_ORIGINS=
VISPR_ALLOW_LOCAL_ENDPOINTS=false
# Operator-provisioned direct deployment secrets use VISPR_PROVIDER_<NAME>.
