{
  "name": "vispr",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @vispr/web dev",
    "build": "pnpm --filter @vispr/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "@types/node": "26.6.3",
    "@electric-sql/pglite": "0.5.8"
  }
}
